{
  "name": "agent-army",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted Slack assistant (Pointer) with a team of Claude agents that answer questions, research, and turn requests into pull requests.",
  "license": "MIT",
  "homepage": "https://github.com/Genpire/agent-army#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Genpire/agent-army.git"
  },
  "bugs": {
    "url": "https://github.com/Genpire/agent-army/issues"
  },
  "keywords": [
    "slack",
    "slack-bot",
    "claude",
    "claude-agent-sdk",
    "ai-agents",
    "multi-agent",
    "github",
    "pull-requests",
    "code-review",
    "self-hosted",
    "cloud-run"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:web",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json && tsc -p demo/tsconfig.json && tsc -p packages/create-agent-army/tsconfig.json",
    "test": "vitest run",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "demo": "npm run build:web && tsx demo/demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.326",
    "@google-cloud/run": "^4.2.0",
    "@google-cloud/storage": "^9.0.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/mcp": "0.0.84",
    "@slack/web-api": "^8.4.0",
    "express": "^5.3.0",
    "fflate": "0.8.2",
    "nodemailer": "10.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astryxdesign/build": "0.7.7",
    "@astryxdesign/cli": "0.7.7",
    "@astryxdesign/core": "0.7.7",
    "@astryxdesign/theme-neutral": "0.7.7",
    "@babel/core": "7.29.7",
    "@dicebear/core": "9.4.3",
    "@dicebear/notionists": "9.4.2",
    "@fontsource/figtree": "5.3.0",
    "@heroicons/react": "2.2.0",
    "@stylexjs/babel-plugin": "0.19.1",
    "@stylexjs/stylex": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "simple-icons": "16.36.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unplugin": "2.3.11",
    "vite": "8.3.5",
    "vitest": "^5.1.0"
  }
}
