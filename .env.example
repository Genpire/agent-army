# Everything else (Claude key, Slack, GitHub, projects) is entered in the web UI.
# So are Pointer's settings: the team (agents, access, models), its memory and the
# Pointer channels. They are stored encrypted with MASTER_KEY, not read from here.

# Encrypts the stored credentials and signs admin sessions. Set it in production.
MASTER_KEY=
# One-time token needed to create the admin account. If unset, one is printed in the log.
SETUP_TOKEN=
# Public base URL, used for the Slack events URL. Auto-detected behind most proxies.
PUBLIC_URL=
# Proxies in front of the app (default 1): the sign-in throttle counts by the address the last one saw.
# Raise it for another proxy in front, such as a cloud load balancer before an ingress; "false" with none.
# TRUST_PROXY=1

# Storage: "fs" (DATA_DIR) or "gcs" (GCS_BUCKET).
STORAGE=fs
DATA_DIR=./data

# Runner: "local" (child process per task) or "cloudrun" (Cloud Run Job per task).
RUNNER=local
# WORKER_JOB=projects/PROJECT/locations/REGION/jobs/agent-army-worker

# Optional repo task limits, in minutes. TASK_TIMEOUT_MIN stops the team's first run (default 50).
# TASK_TIMEOUT_MIN=50
# Hard deadline of the whole worker (team run, waiting for checks, fix rounds, publishing). Unset = none.
# Set it to the job's task timeout on Cloud Run (deploy/gcp.sh sets 180).
# JOB_TIMEOUT_MIN=180
# "off" gives the agents no headless browser in repo tasks (no browser checks or screenshots).
# BROWSER=off
